{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aka.ms/winget-cli-output.list.1.0.schema.json",
  "type": "object",
  "required": ["$schema", "schemaVersion", "command", "mode", "result", "warnings", "errors"],
  "properties": {
    "$schema": { "const": "https://aka.ms/winget-cli-output.list.1.0.schema.json" },
    "schemaVersion": { "const": "1.0" },
    "command": { "const": "list" },
    "mode": { "enum": ["installed", "availableUpgrades"] },
    "result": { "$ref": "https://aka.ms/winget-cli-output.common.1.0.schema.json#/$defs/packageResult" },
    "warnings": {
      "type": "array",
      "items": { "$ref": "https://aka.ms/winget-cli-output.common.1.0.schema.json#/$defs/warning" }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "https://aka.ms/winget-cli-output.common.1.0.schema.json#/$defs/error" }
    }
  },
  "additionalProperties": true
}
